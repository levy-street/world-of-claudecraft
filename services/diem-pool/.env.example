# DIEM delegation pool configuration — copy to .env and edit:
#   cp .env.example .env
# Next.js and the worker process both load it. Every variable the service
# reads is documented here.

# ── Storage ──────────────────────────────────────────────────────────────────

# Postgres connection string (Prisma).
DATABASE_URL=postgresql://diempool:change-me@127.0.0.1:5432/diempool

# Redis, used by BullMQ (settlement + health-check jobs) and rate limiting.
REDIS_URL=redis://127.0.0.1:6379

# ── Secrets ──────────────────────────────────────────────────────────────────

# 32-byte hex key for AES-256-GCM encryption of provider Venice API keys at
# rest. Generate with: openssl rand -hex 32
# Rotating it invalidates stored keys (providers must re-register), so treat
# it like a KMS root key.
KEY_ENCRYPTION_KEY=

# Shared secret the game backend must send as `x-internal-secret` on
# POST /api/internal/inference. Generate with: openssl rand -hex 32
INTERNAL_SHARED_SECRET=

# Token gating the admin dashboard and /api/admin/* routes (`x-admin-token`).
ADMIN_TOKEN=

# ── Venice upstream ──────────────────────────────────────────────────────────

# OpenAI-compatible Venice endpoint.
VENICE_BASE_URL=https://api.venice.ai/api/v1

# Cheapest model used for the ~1-token key-validation call at registration.
VENICE_VALIDATION_MODEL=llama-3.2-3b

# House fallback key used (and tagged `house`) when the provider pool is
# exhausted. Leave empty to return 503 instead of falling back.
HOUSE_VENICE_API_KEY=

# ── Capacity & routing ───────────────────────────────────────────────────────

# Daily USD credit per staked DIEM (Venice refreshes $1/day per DIEM).
DIEM_DAILY_USD=1

# Abuse guard: max DIEM a provider may declare at registration.
MAX_DECLARED_DIEM=10000

# Stop routing to a provider once estimated intraday spend reaches this
# fraction of dailyCapacityUsd (headroom for estimation error).
SPEND_HEADROOM=0.90

# ── Settlement economics ─────────────────────────────────────────────────────

# Claudium minted per USD of consumed compute.
CLAUDIUM_PER_USD=100

# Claudium per USD of *unused* capacity for providers that stayed ACTIVE and
# healthy all day (standby rate).
STANDBY_CLAUDIUM_PER_USD_CAPACITY=5

# Uptime bonus: multiplier applied to the base reward once a provider's
# healthy-day streak reaches UPTIME_STREAK_DAYS.
UPTIME_MULTIPLIER=1.25
UPTIME_STREAK_DAYS=30

# Anti-whale cap: max share of a day's total Claudium emission any single
# provider can earn (0.20 = 20%).
MAX_DAILY_SHARE=0.20

# The share cap only applies when at least this many providers earned rewards
# that day — with a tiny pool the cap would destroy most of the emission
# (e.g. a lone provider could never earn more than 20% of its own reward).
# Set to 1 to always apply the cap literally.
MIN_PROVIDERS_FOR_CAP=5

# Minimum consumed USD before the self-dealing heuristic scores a provider.
SUSPICION_MIN_USD=0.5

# ── Settlement webhook (optional) ────────────────────────────────────────────

# If set, each per-provider settlement is POSTed here (HMAC-SHA256 signed with
# GAME_WEBHOOK_SECRET via `x-wocc-signature`) so the game backend can credit
# the player's Claudium balance. Settlements are also always published to the
# BullMQ queue `settlement-events`.
GAME_WEBHOOK_URL=
GAME_WEBHOOK_SECRET=

# ── Rate limiting ────────────────────────────────────────────────────────────

# Registration attempts allowed per fixed window, per IP and per wallet.
RATE_LIMIT_REGISTER_PER_IP=5
RATE_LIMIT_REGISTER_PER_WALLET=3
RATE_LIMIT_WINDOW_SECONDS=3600
